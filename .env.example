# Optional Cloud LLM API Keys (System automatically falls back to local Ollama llama3.2 if omitted)
# Groq Cloud API Key (Enables ultra-fast Llama-3.1-8b-instant inference)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (Enables Gemini-2.5-flash inference)
GOOGLE_API_KEY=AIzaSy_your_gemini_api_key_here

# Optional: Default Ollama model name when running locally
OLLAMA_MODEL=llama3.2:1b
